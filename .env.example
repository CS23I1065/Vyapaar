# Copy to .env and fill in. .env is gitignored — never commit real keys.

GEMINI_API_KEY=

# Verified working 2026-08-29: gemini-3.5-flash, gemini-3.1-flash-lite.
# gemini-2.5-flash was retired for new users as of this date (404 NOT_FOUND) --
# re-verify before reintroducing it. BANNED: gemini-3.7-flash and
# gemini-flash-latest hang (HTTP 000) -- re-verify before using either.
# See llm/provider.py for the hard timeout that guards against this.
LLM_MODEL_EVAL=gemini-3.1-flash-lite
LLM_MODEL_DEMO=gemini-3.5-flash

# Hard spend ceiling for the eval matrix (eval/budget.py aborts the run before exceeding it).
EVAL_BUDGET_USD=5.00

# Razorpay TEST MODE keys only. Get them from the Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Test-mode webhook secret (Dashboard > Webhooks > Add New Webhook, test mode).
# NOTE: test mode does not generate settlements (see mandates/README / architecture writeup) —
# webhook reconciliation is the real Tier-2 recon path, not settlement recon.
RAZORPAY_WEBHOOK_SECRET=
